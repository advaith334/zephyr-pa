&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;

    sht41: sht4x@44 {
        compatible = "sensirion,sht4x";
        reg = <0x44>;
        repeatability = <2>;
    };
};

/* Configure UART1 for RS485 communication */
&uart1 {
    status = "okay";
    current-speed = <9600>;  // Standard RS485 speed
    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";
};